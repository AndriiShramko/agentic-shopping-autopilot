# config.env — runtime configuration. Lives in the PRIVATE folder (ASA_PRIVATE_DIR or --private-dir;
# default ~/.asa/private), never in git. Only the keys below are accepted; any other key is ignored
# with a warning. Comments must be on their own line. Copy this file, fill in what you use, delete the rest.

# --- mandate ---------------------------------------------------------------------------------------
# Path to the signed PURCHASE_MANDATE.md (default: <private>/PURCHASE_MANDATE.md); MANDATE_REVOKED is looked up next to it.
MANDATE_PATH=
# SHA-256 of sections 1-6, written by `asa mandate:sign`.
MANDATE_SHA256=

# --- Allegro API (optional; without it the agent searches the listing pages of your logged-in browser) --
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_TOKEN_FILE=
# Expected Allegro login (compared with the logged-in account; never printed).
ALLEGRO_LOGIN=

# --- browser channel B (dedicated, headed, logged-in Chrome profile with remote debugging) ------------
CDP_URL=http://127.0.0.1:9222
# 1 = stop before the pay button (the first attended purchases); 0 = the agent presses it.
HUMAN_CONFIRM=1

# --- recipient reference: written by `asa ref:capture`; compared in-process, never printed or logged --
REF_FULL_NAME=
REF_DELIVERY_ADDRESS=
REF_PICKUP_POINT=

# --- Smart! basket -----------------------------------------------------------------------------------
SMART_THRESHOLD_PLN=49.90
SMART_SLACK_PLN=25
MAX_COMPLEMENTS=1
REORDER_COOLDOWN_DAYS=30
# wishlist.jsonl, purchase-history.jsonl, sellers.json, do-not-buy.txt (default: <private>/shopping-profile)
SHOPPING_PROFILE_DIR=
# oneclick_card | allegro_pay
DEFAULT_RAIL=oneclick_card

# --- context-first: the knowledge stores the agent MUST consult before it searches or plans ----------
# Semicolon-separated <kind>:<path>; the kind is everything before the FIRST colon, so Windows drive
# letters are fine. Kinds: obsidian (a vault of Markdown notes), jsonl (the shopping-profile folder),
# folder (any folder of .md / .txt / .json). A path may list `|`-separated fallbacks — the first existing
# directory wins, so one config.env serves two machines. A path with blanks may be quoted:
#   CONTEXT_STORES="obsidian:U:\Vault|C:\Users\me\Documents\My Vault;jsonl:C:\Users\me\.asa\private\shopping-profile"
# `asa search` and `asa basket:plan` refuse to run without a fresh `asa context:brief` for the need at
# hand and a recorded `context:note --query`. ASA_CONTEXT_STORES in the environment overrides this key.
CONTEXT_STORES=obsidian:C:\Users\me\Documents\Vault;jsonl:C:\Users\me\.asa\private\shopping-profile
# Allow-list of a vault (semicolon-separated globs). Only these folders are ever opened; the default is
# 00 - Inbox/**;01 - Projects/**;02 - Areas/**;03 - Resources/**;Daily/** — the vault root, tmp/, Maps/,
# Indexes/, Agents/, Templates/ and everything else stay unread. Setting the key REPLACES the default list.
CONTEXT_INCLUDE=
# Extra exclude globs, semicolon-separated (e.g. Journal/**;Private/**). They EXTEND the defaults, which
# cannot be removed: 04 - Archive/**, Templates/**, Health/**, Финансы/**, Finance/**, Почта/**, Mail/**,
# Отношения/**, Relationships/**, Telegram Archive/**, Deployment/**, Memory/**, *Банковск*, *Брокерск*,
# *Паспорт*, *лечение*, *INDEX*, CHANGELOG*, .log/**; and the hard excludes: any name starting with the lock
# glyph, secrets/**, .git/**, dot-folders, .jsonl files inside a vault. A note opts out with `asa_context: no`.
CONTEXT_EXCLUDE=
# How many snippets a need brief keeps (default 40) and how many per file (default 5).
CONTEXT_MAX_SNIPPETS=40
CONTEXT_MAX_PER_FILE=5
# A note older than this many days is marked !stale in the digest (default 180).
CONTEXT_STALE_DAYS=180
# A brief older than this many minutes is stale for the gate (default 240; counted from the last context:brief).
CONTEXT_BRIEF_MAX_AGE_MIN=240
# 0 (default): `--no-context` does nothing, the gate always stops. 1: the OWNER allows the session to pass the
# gate with `--no-context repeat_purchase|owner_said_in_chat|diagnostic`; every bypass is audited as context_skipped.
CONTEXT_OPTIONAL=0

# --- language of the strings shown to people (proposal, reply feedback, mandate lines written by amend/sign)
# en (default) | ru. Parsers stay bilingual: Russian mandates and replies are always accepted on read.
ASA_LANG=en
